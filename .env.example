# Copy to .env and fill in real values. Never commit .env itself.

# ── VAPI (server-side only — customers never see this) ─
# dashboard.vapi.ai → API Keys
VAPI_API_KEY=vapi_your_key_here

# ── SERVER ────────────────────────────────────────────
PORT=3000
# Required. Server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
APP_URL=http://localhost:3000

# ── ADMIN PANEL (/admin) ──────────────────────────────
ADMIN_USER=admin
# Required. Server refuses to start without it.
ADMIN_PASS=

# ── STRIPE (optional — for billing) ──────────────────
# dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
